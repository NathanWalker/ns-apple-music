{
  "name": "ns-angular",
  "main": "./src/main.ts",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-browser-dynamic": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@nativescript/angular": "^21.0.1-alpha.7",
    "@nativescript/core": "9.1.0-alpha.6",
    "@nativescript/simdeck-inspector": "^0.1.3",
    "@nstudio/nativescript-menu": "^1.0.5",
    "@triniwiz/nativescript-image-cache-it": "^8.0.1",
    "@valor/nativescript-websockets": "^2.0.3",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@nativescript/ios": "9.1.0-alpha.1",
    "@nativescript/tailwind": "^2.1.0",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "8.0.0-alpha.20",
    "@nativescript/webpack": "~5.0.35",
    "@ngtools/webpack": "~21.2.0",
    "concurrently": "^9.0.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "~3.4.0",
    "typescript": "~5.9.0",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "@nativescript/core": "9.1.0-alpha.6",
    "vite": "^8.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev:ios": "concurrently -k -n vite,ns \"npm run dev:server:ios\" \"wait-on tcp:5173 && npm run ios\"",
    "dev:android": "concurrently -k -n vite,ns \"npm run dev:server:android\" \"wait-on tcp:5173 && npm run android\"",
    "dev:server:ios": "vite serve -- --env.ios --env.hmr",
    "dev:server:android": "vite serve -- --env.android --env.hmr",
    "ios": "ns debug ios",
    "android": "ns debug android"
  }
}
