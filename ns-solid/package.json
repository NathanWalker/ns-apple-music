{
  "name": "solidhmr",
  "main": "src/index.ts",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@nativescript-community/solid-js": "^0.1.2",
    "@nativescript/core": "9.1.0-alpha.6",
    "@nativescript/simdeck-inspector": "^0.1.0",
    "@nstudio/nativescript-menu": "^1.0.5",
    "@triniwiz/nativescript-image-cache-it": "^8.0.1",
    "@valor/nativescript-websockets": "^2.0.2",
    "dominative": "^0.1.3",
    "solid-js": "^1.9.11",
    "solid-navigation": "1.0.0-alpha.16",
    "undom-ng": "^1.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-typescript": "^7.23.3",
    "@nativescript-dom/core-types": "~1.0.32",
    "@nativescript-dom/solidjs-types": "~1.0.25",
    "@nativescript/ios": "9.1.0-dev.10",
    "@nativescript/tailwind": "~2.1.0",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "^8.0.0-alpha.17",
    "@nativescript/webpack": "~5.0.32",
    "babel": "^6.23.0",
    "babel-loader": "^9.1.3",
    "babel-preset-solid": "^1.8.19",
    "concurrently": "^9.0.0",
    "patch-package": "^8.0.1",
    "solid-refresh": "^0.7.5",
    "tailwindcss": "~3.4.3",
    "typescript": "~5.9.0",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "@nativescript/core": "9.1.0-alpha.6"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev:ios": "concurrently -k -n vite,ns \"npm run dev:server:ios\" \"wait-on tcp:5173 && npm run ios\"",
    "dev:android": "concurrently -k -n vite,ns \"npm run dev:server:android\" \"wait-on tcp:5173 && npm run android\"",
    "dev:server:ios": "vite serve -- --env.ios --env.hmr",
    "dev:server:android": "vite serve -- --env.android --env.hmr",
    "ios": "ns debug ios",
    "android": "ns debug android"
  }
}
